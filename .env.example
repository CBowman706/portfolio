# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# REQUIRED — server-side only. The /api/chat route reads this; it never reaches the client bundle.
# Get one at https://openrouter.ai/
OPENROUTER_API_KEY=

# OPTIONAL — used by src/app/layout.tsx to set metadataBase for absolute Open Graph URLs.
# Leave unset locally; set in production hosting (e.g. Netlify) to your canonical URL.
# NEXT_PUBLIC_SITE_URL=https://cortneybowman.dev

# OPTIONAL — per-IP rate limit on /api/chat. Defaults: 10/min, 60/hour. See src/lib/rateLimit.ts.
# CHAT_RATE_PER_MINUTE=10
# CHAT_RATE_PER_HOUR=60
